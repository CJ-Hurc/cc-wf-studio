{
  "name": "cc-wf-studio-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo root for cc-wf-studio (VSCode extension, MCP server, CLI, and core schema)",
  "repository": {
    "type": "git",
    "url": "https://github.com/breaking-brake/cc-wf-studio"
  },
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "check": "pnpm --filter @cc-wf-studio/core run build && pnpm -r run check",
    "lint": "pnpm -r run lint",
    "format": "pnpm -r run format",
    "test": "pnpm --filter @cc-wf-studio/core run build && pnpm -r run test",
    "ccwf": "node packages/cli/dist/cli.js",
    "ccwf:dev": "tsx packages/cli/src/cli.ts"
  },
  "devDependencies": {
    "@cc-wf-studio/cli": "workspace:*",
    "@changesets/cli": "^2.31.0",
    "tsx": "^4.19.2"
  },
  "pnpm": {
    "overrides": {
      "smol-toml": "1.8.0",
      "fast-uri": "3.1.8",
      "undici": "7.29.1",
      "ip-address": "10.7.2",
      "nanoid": "3.3.19",
      "postcss": "8.5.28",
      "browserslist": "4.29.0",
      "@toon-format/toon": "2.3.1",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@5": "5.0.12",
      "js-yaml@3": "3.15.2",
      "js-yaml@4": "4.3.2",
      "hono": "4.13.8",
      "@hono/node-server": "2.1.1",
      "qs": "6.16.0",
      "dompurify": "3.4.15",
      "mermaid": "11.17.2",
      "fflate": "0.8.3",
      "vitest": "4.1.11",
      "@vitest/mocker": "4.1.11",
      "@vitest/ui": "4.1.11",
      "body-parser": "2.3.0"
    }
  }
}
